{
  "name": "facturette",
  "version": "0.0.0",
  "description": "Transforme une facture PDF en facture Factur-X (EN 16931), 100 % dans le navigateur.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "validate:facturx": "bun scripts/validate-facturx.ts",
    "verify": "bun run typecheck && bun run check && bun run test"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-router": "^1.170.44",
    "decimal.js": "^10.6.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.46",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-xml-parser": "^5.11.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
